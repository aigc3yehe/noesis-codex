  {
    "name": "theses",
    "path": "/v1/agent-api/theses",
    "scope": "theses:read",
    "description": "Authenticated thesis stream; since/until filter receipt time.",
    "parameters": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "cursor": {
          "type": "string",
          "pattern": "^[a-f0-9]{48}$"
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "expired"
          ]
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
